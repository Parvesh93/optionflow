generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Shopify session storage model.
 * Keep this compatible with:
 * @shopify/shopify-app-session-storage-prisma
 */
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/**
 * OptionFlow models
 */

enum ShopStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  UNINSTALLED
}

enum OptionSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Shop {
  id             String     @id @default(cuid())
  shopifyDomain  String     @unique
  shopifyShopGid String?    @unique
  name           String?
  email          String?
  currencyCode   String?
  timezone       String?
  status         ShopStatus @default(ACTIVE)
  installedAt    DateTime   @default(now())
  uninstalledAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  optionSets OptionSet[]

  @@index([status])
  @@index([deletedAt])
}

model OptionSet {
  id                String          @id @default(cuid())
  shopId            String
  name              String
  handle            String
  description       String?
  internalNote      String?
  status            OptionSetStatus @default(DRAFT)
  displayTitle      String?
  tags              Json?
  priority          Int             @default(0)
  revision          Int             @default(1)
  publishedRevision Int?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, handle])
  @@index([shopId, status, deletedAt])
  @@index([shopId, updatedAt])
}
