generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Shopify session storage model.
 * Keep this compatible with:
 * @shopify/shopify-app-session-storage-prisma
 */
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/**
 * OptionFlow models
 */

enum ShopStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  UNINSTALLED
}

enum OptionSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OptionFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  RADIO
  CHECKBOX
}

enum PriceAdjustmentType {
  NONE
  FIXED
  PERCENTAGE
}

enum ConditionOperator {
  EQUALS
  NOT_EQUALS
  IS_CHECKED
  IS_NOT_CHECKED
}

model Shop {
  id             String     @id @default(cuid())
  shopifyDomain  String     @unique
  shopifyShopGid String?    @unique
  name           String?
  email          String?
  currencyCode   String?
  timezone       String?
  status         ShopStatus @default(ACTIVE)
  installedAt    DateTime   @default(now())
  uninstalledAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  pricingAddonProductGid  String?
  pricingAddonVariantGid  String?
  pricingCartTransformId  String?
  pricingEnabledAt        DateTime?

  optionSets   OptionSet[]
  assignments ProductAssignment[]

  @@index([status])
  @@index([deletedAt])
}

model OptionSet {
  id                String          @id @default(cuid())
  shopId            String
  name              String
  handle            String
  description       String?
  internalNote      String?
  status            OptionSetStatus @default(DRAFT)
  displayTitle      String?
  tags              Json?
  priority          Int             @default(0)
  revision          Int             @default(1)
  publishedRevision Int?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  fields      OptionField[]
  assignments ProductAssignment[]

  @@unique([shopId, handle])
  @@index([shopId, status, deletedAt])
  @@index([shopId, updatedAt])
}


model OptionField {
  id          String          @id @default(cuid())
  optionSetId String
  type        OptionFieldType
  label       String
  placeholder String?
  helpText    String?
  isRequired          Boolean             @default(false)
  priceAdjustmentType PriceAdjustmentType @default(NONE)
  priceAdjustmentValue Decimal?            @db.Decimal(12, 4)
  position            Int                 @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  optionSet           OptionSet         @relation(fields: [optionSetId], references: [id], onDelete: Restrict)
  values              OptionValue[]
  conditions          OptionCondition[] @relation("TargetFieldConditions")
  dependentConditions OptionCondition[] @relation("SourceFieldConditions")

  @@index([optionSetId, position, deletedAt])
}

model OptionValue {
  id            String   @id @default(cuid())
  optionFieldId String
  label         String
  value                String
  priceAdjustmentType  PriceAdjustmentType @default(NONE)
  priceAdjustmentValue Decimal?            @db.Decimal(12, 4)
  position             Int                 @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  optionField OptionField @relation(fields: [optionFieldId], references: [id], onDelete: Restrict)

  @@index([optionFieldId, position, deletedAt])
}


model OptionCondition {
  id             String            @id @default(cuid())
  targetFieldId  String
  sourceFieldId  String
  operator       ConditionOperator
  expectedValue  String?
  position       Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  targetField OptionField @relation("TargetFieldConditions", fields: [targetFieldId], references: [id], onDelete: Restrict)
  sourceField OptionField @relation("SourceFieldConditions", fields: [sourceFieldId], references: [id], onDelete: Restrict)

  @@index([targetFieldId, position, deletedAt])
  @@index([sourceFieldId, deletedAt])
}


model ProductAssignment {
  id              String   @id @default(cuid())
  shopId          String
  optionSetId     String
  productGid      String
  productTitle    String
  productHandle   String
  productImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Restrict)

  @@unique([shopId, productGid])
  @@index([optionSetId])
  @@index([shopId, optionSetId])
}
