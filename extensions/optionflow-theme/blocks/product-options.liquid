<div
  class="optionflow-product-options"
  data-optionflow-root
  data-optionflow-product-gid="gid://shopify/Product/{{ product.id }}"
  data-optionflow-base-price="{{ product.selected_or_first_available_variant.price }}"
  data-optionflow-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-optionflow-show-title="{{ block.settings.show_title }}"
>
  <div class="optionflow-product-options__loading">
    {{ block.settings.loading_text | escape }}
  </div>
</div>

{% schema %}
{
  "name": "OptionFlow options",
  "target": "section",
  "javascript": "optionflow.js",
  "stylesheet": "optionflow.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show option set title",
      "default": false
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Loading options..."
    }
  ]
}
{% endschema %}
